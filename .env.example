# App Base URL (Gunakan domain publik Anda saat deploy di Vercel)
NEXTAUTH_URL="https://lembar.atnan.my.id"
NEXTAUTH_SECRET="masukkan_random_string_rahasia_untuk_nextauth_di_vercel"

# Database Connection (PostgreSQL: Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Google OAuth Credentials (Dari Google Cloud Console)
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# AES-256-GCM Token Encryption Key (32-byte hex string: misal hasil openssl rand -hex 32)
ENCRYPTION_KEY="4a8b7c2d1e9f0a5b6c3d8e2f7a1b9c0d4e8f2a6b0c4d8e2f6a0b4c8d2e6f0a4b"

# Upstash Redis (Opsional, untuk rate limiting global serverless di Vercel)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
